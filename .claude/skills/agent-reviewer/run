#!/usr/bin/env bash
# .claude/skills/agent-reviewer/run — real Tier-1 agent-reviewer invocation.
#
# Computes the diff, hashes it, checks a local verdict cache, and invokes
# `claude -p` to produce a JSON verdict per agent-reviewer schema v1.
#
# Verdict file (keyed by diff hash, read by commit hook hk-q6axs.4):
#   <git-root>/.harmonik/verdicts/<diff-hash>.json
#
# Exit 0: APPROVE or REQUEST_CHANGES (commit may proceed)
# Exit 1: BLOCK verdict or internal error
#
# Usage: run [--diff <REF>] [--bead <BEAD-ID>]
#        run --validate
#        run --print-prompt [--diff <REF>] [--bead <BEAD-ID>]
#   --diff REF      Git ref to diff from (default: HEAD~1)
#   --bead ID       Optional bead ID for review context (auto-detected from Refs: trailer)
#   --validate      Validate one verdict JSON object from stdin without invoking Claude.
#   --print-prompt  Build the review prompt and print it. No model call, no cache write.
#
# THE CHECKS AND THE FLAG VOCABULARY ARE NOT WRITTEN HERE. They are read out of
# SKILL.md, which is the contract, every time this script builds a prompt.
#
# They used to be written here, as a hand-kept summary, and the two drifted. On
# 2026-08-05 the contract declared eight checks and sixteen flags; this prompt
# named six checks and eleven flags.
#
# Be precise about what that cost, because the first version of this comment was
# not and a reviewer caught it. Two of the four uncarried checks WERE asked, under
# shortened headings: "Production wire-up" for production call-site wiring, and
# "Unwanted abstraction" for unwanted-abstraction detection. Two were absent
# outright and had no counterpart in the prompt at all — spec field-name
# conformance, and the reproducing test for bug beads. Five flags were never named
# to the model, so the reviewer could not raise them whatever it found.
#
# The summary also still recommended `defer cleanup discards`, which errcheck has
# reported as a finding since `check-blank: true` was set.
#
# A summary of a contract is a second copy of the contract. Read the contract.
# scripts/agent-reviewer-prompt-parity-test.sh holds this shut.

SKILL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "agent-reviewer: not inside a git repository" >&2
    exit 1
}

# ── Parse args ────────────────────────────────────────────────────────────────
DIFF_REF="HEAD~1"
BEAD_ID=""
VALIDATE_ONLY=false
PRINT_PROMPT=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --diff) DIFF_REF="$2"; shift 2 ;;
        --bead) BEAD_ID="$2"; shift 2 ;;
        --validate) VALIDATE_ONLY=true; shift ;;
        --print-prompt) PRINT_PROMPT=true; shift ;;
        *) echo "agent-reviewer: unknown argument: $1" >&2; exit 1 ;;
    esac
done

# The contract text and the verdict cache key both live in verdict-key.sh,
# because scripts/check-verdict.sh reads back what this script writes and the two
# have to agree. See that file for why.
#
# THIS SCRIPT DOES NOT SET `set -e`. A failed source therefore does not stop it,
# and the failure is silent and catastrophic: `agent_reviewer_diff` is undefined,
# the diff comes back empty, the empty-diff branch fires, and the gate emits
# APPROVE with exit 0 on a real diff having never called a model. That is a
# fail-OPEN in the review gate, so it is guarded explicitly rather than left to
# shell options. scripts/check-verdict.sh had this guard from the start; the same
# guard was missing here, which is the asymmetry that made it reachable.
if [[ ! -f "${SKILL_DIR}/verdict-key.sh" ]]; then
    echo "agent-reviewer: cannot find ${SKILL_DIR}/verdict-key.sh" >&2
    echo "agent-reviewer: refusing to review — the verdict key is defined there" >&2
    exit 1
fi
# shellcheck source=./verdict-key.sh
. "${SKILL_DIR}/verdict-key.sh"

# A file that exists but does not define what it should is the same failure with
# a friendlier face. Fail closed on it too.
for required in agent_reviewer_contract agent_reviewer_verdict_key agent_reviewer_diff; do
    if ! declare -F "$required" >/dev/null; then
        echo "agent-reviewer: ${SKILL_DIR}/verdict-key.sh did not define ${required}" >&2
        echo "agent-reviewer: refusing to review" >&2
        exit 1
    fi
done

read_contract() {
    agent_reviewer_contract "$SKILL_DIR"
}

build_prompt() {
    local bead_section="$1"
    local diff_body="$2"
    local contract
    contract="$(read_contract)" || return 1

    cat <<PROMPT_END
You are agent-reviewer for the harmonik project.
Review the diff below and emit ONLY a single JSON verdict object — no prose, no markdown fences, no explanation.

JSON-verdict schema v1 (emit exactly this shape):
{"schema_version":1,"verdict":"APPROVE|REQUEST_CHANGES|BLOCK","flags":[],"notes":"..."}

Required fields: schema_version (integer 1), verdict (string), flags (array), notes (string, 1-3 sentences).

Verdict meanings:
- APPROVE: all checks pass.
- REQUEST_CHANGES: issues found but commit may proceed if agent records rationale.
- BLOCK: hard violation; do not commit.

Use only the flag tags named in the vocabulary table below. Perform every numbered
check. The deletion-accounting check reads what the diff REMOVES — answer it even
when the diff looks like an addition.

The contract below tells you to emit findings per check. On this path there is
nowhere to put them but the JSON, so: do the work of every check, then put in notes
the findings that decide the verdict, worst first. A check you ran and that found
nothing does not need a sentence. Do not write prose outside the JSON object, and
do not put a code fence or a Go snippet inside notes — a stray brace there is how
this gate used to fail.

${contract}

${bead_section}## Diff (git diff ${DIFF_REF})

\`\`\`diff
${diff_body}
\`\`\`

Emit the JSON verdict object now (no prose, no fences):
PROMPT_END
}

validate_verdict() {
    python3 -c '
import json
import sys

try:
    verdict = json.load(sys.stdin)
except json.JSONDecodeError as exc:
    sys.stderr.write("agent-reviewer: JSON parse error: " + str(exc) + "\n")
    sys.exit(1)

if not isinstance(verdict, dict):
    sys.stderr.write("agent-reviewer: verdict must be a JSON object\n")
    sys.exit(1)

required = {"schema_version", "verdict", "notes"}
allowed = required | {"flags"}
missing = required - verdict.keys()
unexpected = verdict.keys() - allowed
if missing:
    sys.stderr.write("agent-reviewer: missing field(s): " + ", ".join(sorted(missing)) + "\n")
    sys.exit(1)
if unexpected:
    sys.stderr.write("agent-reviewer: unknown field(s): " + ", ".join(sorted(unexpected)) + "\n")
    sys.exit(1)
if type(verdict["schema_version"]) is not int or verdict["schema_version"] != 1:
    sys.stderr.write("agent-reviewer: schema_version must be integer 1\n")
    sys.exit(1)
if verdict["verdict"] not in {"APPROVE", "REQUEST_CHANGES", "BLOCK"}:
    sys.stderr.write("agent-reviewer: unknown verdict: " + repr(verdict["verdict"]) + "\n")
    sys.exit(1)
if not isinstance(verdict["notes"], str):
    sys.stderr.write("agent-reviewer: notes must be a string\n")
    sys.exit(1)
if "flags" in verdict and (
    not isinstance(verdict["flags"], list)
    or not all(isinstance(flag, str) for flag in verdict["flags"])
):
    sys.stderr.write("agent-reviewer: flags must be an array of strings\n")
    sys.exit(1)

print(json.dumps(verdict, separators=(",", ":")))
'
}

if [[ "$VALIDATE_ONLY" == true ]]; then
    validate_verdict
    exit $?
fi

# ── Bead context ─────────────────────────────────────────────────────────────
resolve_bead_section() {
    if [[ -z "$BEAD_ID" ]]; then
        BEAD_ID="$(git log -1 --format='%(trailers:key=Refs,valueonly)' 2>/dev/null \
            | tr -d ' ' | head -1)"
    fi

    [[ -n "$BEAD_ID" ]] && command -v br &>/dev/null || return 0

    local raw title notes
    raw="$(br show "${BEAD_ID}" --format json 2>/dev/null)" || return 0
    [[ -n "$raw" ]] || return 0

    title="$(printf '%s' "$raw" \
        | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0].get('title',''))" \
        2>/dev/null)" || title=""
    notes="$(printf '%s' "$raw" \
        | python3 -c "import json,sys; d=json.load(sys.stdin); print(d[0].get('notes',''))" \
        2>/dev/null)" || notes=""

    printf '## Work item: %s\nTitle: %s\n%s\n' \
        "$BEAD_ID" "$title" "${notes:+Notes: ${notes}}"
}

# ── Compute diff ──────────────────────────────────────────────────────────────
# Shared with scripts/check-verdict.sh: the two must compute the diff the same
# way as well as hash it the same way, or they resolve different verdict files.
DIFF="$(agent_reviewer_diff "$DIFF_REF")"

# --print-prompt answers "what does the reviewer actually get asked", so it must
# build the prompt whether or not a diff happens to be in the tree right now.
if [[ "$PRINT_PROMPT" == true ]]; then
    build_prompt "$(resolve_bead_section)" \
        "${DIFF:-(no diff in the working tree; this is a --print-prompt run)}"
    exit $?
fi

if [[ -z "$DIFF" ]]; then
    echo "agent-reviewer: empty diff for ${DIFF_REF}; nothing to review" >&2
    TRIVIAL='{"schema_version":1,"verdict":"APPROVE","flags":[],"notes":"Empty diff; nothing to review."}'
    printf '%s\n' "$TRIVIAL"
    exit 0
fi

# ── Cache key: the diff AND the contract it was judged against ───────────────
DIFF_HASH="$(agent_reviewer_verdict_key "$SKILL_DIR" "$DIFF")" || exit 1

# ── Verdict cache ─────────────────────────────────────────────────────────────
VERDICTS_DIR="${GIT_ROOT}/.harmonik/verdicts"
VERDICT_FILE="${VERDICTS_DIR}/${DIFF_HASH}.json"
mkdir -p "$VERDICTS_DIR"

if [[ -f "$VERDICT_FILE" ]]; then
    echo "agent-reviewer: cache hit ${DIFF_HASH}" >&2
    VERDICT_JSON="$(validate_verdict < "$VERDICT_FILE")" || {
        echo "agent-reviewer: cached verdict is invalid" >&2
        exit 1
    }
else
    PROMPT="$(build_prompt "$(resolve_bead_section)" "$DIFF")" || {
        echo "agent-reviewer: could not build the review prompt" >&2
        exit 1
    }

    # ── Invoke LLM ────────────────────────────────────────────────────────────
    MODEL="${AGENT_REVIEW_MODEL:-claude-haiku-4-5-20251001}"
    RAW_RESPONSE="$(printf '%s\n' "$PROMPT" \
        | claude -p \
            --dangerously-skip-permissions \
            --output-format text \
            --model "$MODEL" \
            2>/dev/null)" || {
        echo "agent-reviewer: claude invocation failed" >&2
        exit 1
    }

    # ── Extract and validate JSON from LLM response ───────────────────────────
    # python3 -c with single-quoted shell string; Python code uses double quotes only.
    VERDICT_JSON="$(printf '%s\n' "$RAW_RESPONSE" | python3 -c "
import sys, json, re

text = sys.stdin.read()
text = re.sub(r'\`\`\`[a-z]*\n?', '', text)

# Scan for balanced JSON objects instead of matching first-brace-to-last.
# The greedy form this replaces span the whole response, so any stray brace in
# the prose around the verdict made the object unparseable and hard-failed the
# gate. That went from theoretical to likely once the prompt started carrying
# the contract, whose idiom section is full of Go snippets a reviewer may quote.
# Strings and escapes are tracked so a brace inside a JSON string does not count.
def objects(s):
    depth = 0
    start = -1
    in_str = False
    esc = False
    for i, ch in enumerate(s):
        if in_str:
            if esc:
                esc = False
            elif ch == '\\\\':
                esc = True
            elif ch == '\"':
                in_str = False
            continue
        if ch == '\"':
            in_str = True
        elif ch == '{':
            if depth == 0:
                start = i
            depth += 1
        elif ch == '}':
            if depth > 0:
                depth -= 1
                if depth == 0:
                    yield s[start:i + 1]

# Take the LAST parseable object that looks like a verdict. A model that thinks
# out loud emits its reasoning first and its answer last.
d = None
for candidate in objects(text):
    try:
        parsed = json.loads(candidate)
    except ValueError:
        continue
    if isinstance(parsed, dict) and 'verdict' in parsed:
        d = parsed

if d is None:
    sys.stderr.write('agent-reviewer: no JSON verdict object in LLM response\n')
    sys.stderr.write(text[:500] + '\n')
    sys.exit(1)

for k in ('schema_version', 'verdict', 'notes'):
    if k not in d:
        sys.stderr.write('agent-reviewer: missing field: ' + k + '\n')
        sys.exit(1)

if d['schema_version'] != 1:
    sys.stderr.write('agent-reviewer: wrong schema_version\n')
    sys.exit(1)

if d['verdict'] not in ('APPROVE', 'REQUEST_CHANGES', 'BLOCK'):
    sys.stderr.write('agent-reviewer: unknown verdict: ' + str(d['verdict']) + '\n')
    sys.exit(1)

if not isinstance(d.get('flags', []), list):
    sys.stderr.write('agent-reviewer: flags must be an array\n')
    sys.exit(1)

print(json.dumps(d, separators=(',', ':')))
")" || {
        echo "agent-reviewer: verdict extraction failed" >&2
        echo "LLM response: ${RAW_RESPONSE:0:300}" >&2
        exit 1
    }

    VERDICT_JSON="$(printf '%s\n' "$VERDICT_JSON" | validate_verdict)" || {
        echo "agent-reviewer: verdict validation failed" >&2
        exit 1
    }

    # ── Store verdict keyed by diff hash ──────────────────────────────────────
    printf '%s\n' "$VERDICT_JSON" > "$VERDICT_FILE"
fi

# ── Emit verdict to stdout ────────────────────────────────────────────────────
printf '%s\n' "$VERDICT_JSON"

# ── Exit based on verdict ─────────────────────────────────────────────────────
VERDICT_VALUE="$(printf '%s\n' "$VERDICT_JSON" \
    | python3 -c "import json,sys; print(json.load(sys.stdin).get('verdict',''))" 2>/dev/null)"

case "$VERDICT_VALUE" in
    APPROVE|REQUEST_CHANGES)
        exit 0 ;;
    BLOCK)
        echo "agent-reviewer: BLOCK — fix issues before committing" >&2
        exit 1 ;;
    *)
        echo "agent-reviewer: unknown verdict '${VERDICT_VALUE}'" >&2
        exit 1 ;;
esac
