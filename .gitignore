.DS_Store
*.swp
*.swo
*~

# kerf working state.
# We TRACK the design-reasoning knowledge (works/ + the standard-bead process
# template + project metadata) so it survives a machine loss and merges to main
# via the per-work `kerf/<codename>` branch convention (see
# docs/components/internal/kerf.md §"Artifact durability & commit convention").
# We still IGNORE: the large local caches (diagnostics-cache.json ~56MB,
# sync-cache.json) and kerf's internal per-edit .history/ snapshot trail (git is
# our history now — tracking it would bloat the repo with thousands of dup files).
.kerf/*
!.kerf/project-identifier
!.kerf/jigs/
!.kerf/jigs/*.md
!.kerf/works/
!.kerf/standard-bead-dot/
!.kerf/config.yaml
!.kerf/project.yaml
# Re-ignore caches and history-snapshots inside the now-tracked subtrees.
.kerf/works/**/.history/
.kerf/**/*-cache.json

# Beads task ledger — ignore SQLite DB / WAL / locks / backups; track only test fixtures
# issues.jsonl is gitignored: `br sync --flush-only` writes it continuously, so tracking it
# creates a perpetually dirty working tree that triggers implementer_escaped_worktree false-fails
# when the daemon runs. Same fix applied to HANDOFF.md (15382e4f). Refs: hk-yru
.beads/*
!.beads/queue-test-fixtures/

# Beads ledger backup directories created by ledger-archive-runbook.md rollback step
.beads.bak*/

# Go build outputs and test artifacts (build-practices.md §Git hygiene)
/bin/
/dist/
/coverage.out
*.test

# Twin-binary build artifacts (SH-009 in-tree default dir; binaries are not committed)
/twins/*
!/twins/.gitkeep

# Harmonik runtime state (context/ is committed as tier-3/tier-2 bootstrap; see leanfleet D5)
# crew/missions/ is committed so mission self-terminate clauses are reviewable in git (hk-ev9e)
/.harmonik/*
!/.harmonik/context
!/.harmonik/crew
!/.harmonik/crew/missions
!/.harmonik/release-ledger.json
!/.harmonik/agents
# Daemon-written task files in worktrees (hk-ynn8u)
.harmonik/agent-task*

# Dev tools installed locally (subsystem-organization.md §Decisions #10).
# Pattern without trailing slash so git also ignores a worktree-local symlink
# that productionWorktreeFactory creates to make these tools accessible in
# worktrees (hk-gb3ln). A trailing slash only matches directories; without it
# the pattern matches files, symlinks, and directories alike.
/.tools

# Orchestrator-spawned implementer worktrees (HANDOFF v23 friction note)
/.claude/worktrees/

# Stray sub-agent scratch dirs
/.claire/

# bv (beads viewer) local config and caches
.bv/
/harmonik
/harmonik-twin-claude

# Pi extension node_modules (npm install output; lockfile is committed)
.pi/extensions/*/node_modules/

# Scoped credential file read by `harmonik supervise start` (CI-006, CI-007).
# MUST NOT be committed — contains ANTHROPIC_API_KEY in plaintext.
.env
.env.*
*.env
.env.*.local
*.env.txt
edited.env.txt

# Session handoffs (operator/agent working artifacts) — ALL of them are untracked,
# the repo-root HANDOFF.md included. Two independent reasons, both load-bearing:
#   1. HANDOFF.md is a per-session artifact, not source. While it was tracked, a
#      checkout/revert would overwrite the live session's baton with a stale one
#      (15382e4f1, "session artifact was tracked, causing reverts to stale handoffs").
#   2. Per-thread HANDOFF-<name>.md are scratch; tracked or merely dirty, the daemon's
#      worktree-escape detector reads them as main-repo contamination and fails
#      dispatched beads (hk-veoht follow-up).
# Consequence, by design: a handoff has NO git history and NO copy on a fresh clone.
# Do NOT "restore" tracking — capture anything durable in a doc, spec, or bead instead.
HANDOFF.md
HANDOFF-*.md

# Claude Code session scheduler lock
.claude/scheduled_tasks.lock

# Claude Code PID file written to repo root by `claude --dangerously-skip-permissions` runs
.claude-pid

# Scratch/exploratory docs not intended for permanent tracking
docs/qa-scratch/

# Local AI-tool search indexes / caches — kept on disk for the tools that use
# them, but regenerable and never committed (.ee = ee search index incl. binary
# tantivy files; .cass = CASS cache; .codex = local codex rules/cache).
.ee/
.cass/
.codex/

# Ephemeral comms subscribe dumps written next to plan/work dirs
.subscribe.jsonl
**/.subscribe.jsonl

# Python bytecode
__pycache__/
*.pyc

# Daemon-materialized per-worktree; must NOT be tracked (CHB-005/hk-jvzc2, hk-5isix fleet-wide rebase-abort)
.claude/settings.json

# Crew registry JSON is daemon-managed runtime state — must NOT be tracked
# (fleet-wide rebase-abort: tracked admiral.json deletion dirtied the merge index).
# Missions (*.md) stay tracked for reviewability (hk-ev9e).
/.harmonik/crew/*.json
.harmonik/events/baseline-2026-07-13/

# Scenario runs materialize a real .harmonik/ inside the fixture tree, including
# per-session keeper context gauges that carry a live session id. That is runtime
# state leaking into testdata, not fixture data — ignore it so a test run cannot
# dirty the tree. (Scoped deliberately: 12 keeper *.ctx files were already
# tracked elsewhere before this rule; whether THOSE belong in git is a separate
# operator call, and a blanket *.ctx ignore would half-fix it.)
scenarios/**/testdata/.harmonik/

# Per-type schema/TS dump produced by an EXTERNAL tool, not by this repo:
#   codex app-server generate-json-schema --out testdata/codex-app-server/gen
#   codex app-server generate-ts          --out testdata/codex-app-server/gen
# 852 files / 5.7 MB, read by zero Go code, and a redundant expansion of the
# canonical single-blob schema we DO track (testdata/codex-app-server/protocol-schema.json,
# captured from codex-cli 0.142.5 — see testdata/codex-app-server/T0-findings.md).
# Tracking it would pin us to one external codex version, which this project
# deliberately does not do.
testdata/codex-app-server/gen/

# Agent-written durable notes (operator feedback, project findings). This is
# session-produced state, not source: agents write here mid-session, so tracking
# it would make routine sessions dirty the tree. Same category as the two rules
# above — those are per-worktree daemon-materialized files, and the crew-JSON one
# was added after a tracked copy dirtied the merge index during a fleet-wide
# rebase. Ignoring does NOT delete anything: the files stay on disk, they are
# simply not carried by git. If these notes should survive a machine loss, back
# them up outside the working tree rather than tracking them here.
.memory/

# Nested .harmonik/ dirs are agent runtime scratch written from a wrong CWD.
# Never source. The root /.harmonik/ has its own rules above.
**/*/.harmonik/
