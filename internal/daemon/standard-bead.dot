// standard-bead.dot — the standard harmonik bead workflow (v1)
//
// The canonical bead lifecycle: implement → commit-gate (build+vet+test+scenario)
// → independent review → close, with review APPROVE as the SOLE inbound edge to
// close. Unions implement-review-fix.dot and green-build-merge-gate.dot into one
// complete workflow. No daemon code change required.
//
// Topology:
//   start
//   → implement (agent: implementer; commit required)
//   → commit_gate (tool: make core — the core set: can beads run through the queue? fail-closed)
//     SUCCESS                   → review
//     FAIL + deterministic      → implement (fix-loop, capped at 3)
//     FAIL + transient          → commit_gate (self-loop, capped at 2)
//     fallback                  → close-needs-attention (canceled / structural)
//   → review (agent: reviewer)
//     APPROVE                   → close (SOLE inbound edge to close)
//     REQUEST_CHANGES           → implement (fix-loop, capped at 3)
//     BLOCK                     → close-needs-attention
//     fallback                  → close-needs-attention
//
// Key design decisions:
//   D1=A: single shell commit_gate node (NOT separate build/test/scenario nodes).
//   D3=v3: the gate is `make core` — THE CORE SET ONLY, fail-closed. Operator
//     instruction, standing: the only question this gate answers is "can this
//     run beads through the queue?". `make core` is named and built for exactly
//     that — the 29 CORE_PKGS, run WITHOUT `-short`, so it executes TestSmokeLoop
//     (real ledger, real worktree, real merge, bead to closed) and
//     TestScenario_HappyPath_N1. `make full` runs those same packages WITH
//     `-short` and skips both; it stays the merge decision on the integration
//     branch and in CI, where nothing is blocked waiting on it.
//     This is NOT the fail-open v1.1 gate that v2 deleted. That one chose
//     packages by asking git what changed since main — main is over a thousand
//     commits behind, so the question was unanswerable — and it had five ways to
//     APPROVE work that never passed against one way to block. CORE_PKGS is a
//     FIXED list in the Makefile and inherits neither defect.
//     v2's reason for going whole-repo was that a red in an unrelated package
//     should block every bead. That is a defensible merge policy and it belongs
//     on the merge decision, not on the per-bead gate: a broad gate made the
//     scenario tier's own load-flakiness into a release blocker three times over.
//     D3=v3 ALSO covers the script self-tests, and this is the record of that
//     half. `make core` calls the Makefile target gate-static-product, while
//     `make fast` and `make full` call gate-static. The single difference is
//     `script-tests`, the self-tests for the shell scripts the gates depend on:
//     gate-static-product does not run them. So the per-bead gate still RUNS
//     secret-scan.sh, commit-msg-gate.sh and lint-changed.sh, but it no longer
//     runs the tests that prove those scripts refuse what they exist to refuse.
//     That proof now lives only in `fast`, `full` and CI. Read it as a real
//     reduction: scripts/gate-fails-closed-test.sh exists because secret-scan.sh
//     had no caller for twenty days AND was admitting a key when a test was
//     finally written for it. The trade buys a gate that does not spend its first
//     minutes proving lint-allow-test.sh works. Anything citing D3=v3 for the
//     script-tests decision means THIS paragraph.
//   The SOLE-inbound-edge invariant: no path reaches close except review→close[APPROVE].
//     THIS IS UNASSERTED. It is a contract this graph is written to and nothing
//     tests it. An earlier version of this line called it golden-test-asserted
//     and named internal/workflow/scenario_standard_bead_hkp0kum_test.go; that
//     file does not exist, and a search for any test that walks the edges into
//     close on this graph found none. Treat the invariant as a rule a human must
//     hold, not one the suite will catch you breaking. Bead hk-sr0f1 is the record.
//
// Spec refs:
//   - docs/sdlc-workflow-corpus.md §1  (implement-review-fix reference topology)
//   - docs/sdlc-workflow-corpus.md §15 (green-build-merge-gate topology)
//   - specs/workflow-graph.md §4 WG-039 — tool_command / shell handler
//   - specs/workflow-graph.md §5 WG-011 — unconditional-edge fallback invariant
//   - specs/workflow-graph.md §6 WG-013 — v1 edge-condition dialect (== and && only)
//   - specs/workflow-graph.md §6 WG-028 — traversal_cap
//   - specs/workflow-graph.md §8 WG-021..WG-023 — terminal-node declaration
//   - specs/workflow-graph.md §9 WG-027 — start_node attribute
//   - specs/execution-model.md §II.7 EM-057 item 7 — exit-code → outcome
//   - specs/execution-model.md §EM-015d (review-loop topology / verdict routing)
//   - specs/execution-model.md §EM-015e (iteration cap + no-progress detector)
//   - specs/handler-contract.md §III.1 HC-063 — in-process shell handler
//   - specs/handler-contract.md §4.1 HC-001 — handler_ref required on every node
//
// Source: harmonik-productization-design workflow 2026-06-02.
// Bead ref: hk-p0kum.

digraph "standard-bead" {
    // ─── Graph-level attributes ──────────────────────────────────────────────
    schema_version="1";
    version="1.0";
    workflow_id="standard-bead";
    start_node="start";
    terminal_node_ids="close,close-needs-attention";
    context_keys="bead_id";

    // ─── Nodes ───────────────────────────────────────────────────────────────

    // start: workflow entry point.
    start [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="entry"
    ];

    // implement: agentic implementer. On the first visit, produces the change.
    // On re-entry (after REQUEST_CHANGES or a deterministic commit_gate failure),
    // addresses the reviewer feedback or fixes the build/test failure.
    implement [
        type="agentic",
        agent_type="implementer",
        handler_ref="claude-implementer",
        idempotency_class="non-idempotent",
        role="implement the bead's change; commit required. On re-entry: address reviewer feedback or fix the build/test failure."
    ];

    // commit_gate: `make core` — the per-bead gate, defined in the Makefile.
    // It runs the static half (format, `go build ./...`, `go vet ./...`, the
    // subsystem freeze greps, the changed-line lint) and then the 29 CORE_PKGS
    // WITHOUT `-short`. That set is the run path: queue, queue wiring, ledger
    // CLI, workspace, daemon, run loop / exec / lease / launch, workflow and the
    // graph engine, merge, merge queue, core, handler, git probe and the CLI.
    //
    // A PER-BEAD GATE MUST BE CHEAP. `make full` costs roughly 19-22 minutes and
    // every bead was paying it; that is not what it is for. `make full` is the
    // integration-branch-into-main decision and it runs there and in CI only.
    //
    // Fail-closed at every step. No retry, and no path that reports SUCCESS on a
    // timeout, an OOM, a compile failure or an exit code nothing recognised.
    //
    // This gate IS package-scoped — to the fixed CORE_PKGS list named above. An
    // earlier version of this comment said "no package scoping", which the same
    // comment then contradicted eight lines up by naming 29 packages. What the
    // v1.1 gate did and this one does not is DERIVE the scope, by asking git what
    // changed since main. A fixed list in the Makefile is still a scope; it is
    // just one that cannot silently shrink to nothing.
    //
    // scripts/gate-fails-closed-test.sh covers `core` as of 2026-08-13, and the
    // claim it holds is exactly one: STRUCTURALLY, every step of `make core`
    // propagates its exit status. Its behavioural cases drive `gate-test-compile`
    // and `full` and do not reach `core`. So read it as proof that no step of this
    // gate swallows a failure — not as proof that the gate tests the right things.
    //
    // Keeping the gate here rather than in the graph is deliberate: the graph
    // used to carry its own copy of the command, so the graph and the Makefile
    // could disagree about what "passing" meant. There is one definition now.
    // Exit 0 (SUCCESS) → every check passed → advance to review.
    // Non-zero deterministic → build / vet / test-compile / test failure → loop back to implement (capped at 3).
    // Non-zero transient → infra glitch → self-loop retry (capped at 2).
    // Any other outcome → unconditional fallback → close-needs-attention.
    commit_gate [
        type="non-agentic",
        handler_ref="shell",
        idempotency_class="idempotent",
        tool_command="make core",
        // THE GATE IS `make core`, NOT `make full`. The operator's standing
        // instruction is that the only question this gate answers is "can this
        // run beads through the queue?" — which is what `make core` is named
        // and built for. `make full` is the whole-repo merge decision; it stays
        // the merge decision on the integration branch and in CI, where nothing
        // is blocked waiting for it.
        //
        // This is NARROWER IN BREADTH AND DEEPER ON THE RUN PATH. `make core`
        // runs the 29 CORE_PKGS **without** `-short`, so it executes the two
        // tests that are the actual claim — TestSmokeLoop (real ledger, real
        // worktree, real merge, bead to closed) and TestScenario_HappyPath_N1
        // (full event subsequence to closed). `make full` runs those same
        // packages WITH `-short` and skips both.
        //
        // It is NOT a return to the fail-open v1.1 gate that D3=v2 deleted.
        // That gate chose packages by asking git what changed since main, and
        // main is over a thousand commits behind, so the question was
        // unanswerable; it also had five ways to APPROVE work that never passed
        // against one way to block. CORE_PKGS is a FIXED list in the Makefile,
        // so it inherits neither defect.
        //
        // The node timeout must clear the work the node does, or a real red can
        // never report. At 900s this node timed out deterministically, was
        // classified TRANSIENT, burned its self-loop budget and died in
        // close-needs-attention having never said WHICH test failed. 3600s is
        // kept deliberately generous — it is a ceiling, not a wait, and `make
        // core` is far cheaper than the `make full` it replaces. A timeout here
        // is a hard FAIL, never an approval.
        timeout="3600",
        role="commit gate: make core — the core set only: can this run beads through the queue? fail-closed; exit 0 = ready for review"
    ];

    // review: agentic reviewer. Emits an Outcome whose preferred_label
    // (APPROVE / REQUEST_CHANGES / BLOCK) drives the cascade below.
    // harness="claude-code" pins review to Claude at tier 3 so the reviewer
    // stays on Claude even when the global default (tier 4) is pi — avoids
    // the Pi-reviewer pane seed-paste bug (hk-z4nif). hk-ytzj2.
    review [
        type="agentic",
        agent_type="reviewer",
        handler_ref="claude-reviewer",
        idempotency_class="idempotent",
        model="claude-opus-4-8",
        harness="claude-code",
        role="render APPROVE / REQUEST_CHANGES / BLOCK verdict on the change"
    ];

    // close: terminal node — APPROVE path only. The SOLE inbound edge is
    // review→close[APPROVE]. No other path reaches this node.
    close [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="APPROVE — change accepted and ready to merge"
    ];

    // close-needs-attention: terminal node for BLOCK, cap-hit, gate fallback,
    // and any unrecognized outcome.
    "close-needs-attention" [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="BLOCK / cap-hit / structural / unexpected — operator attention required"
    ];

    // ─── Edges ───────────────────────────────────────────────────────────────

    // (1) Entry edge — unconditional.
    start -> implement;

    // (2) Implementer advances to commit_gate — unconditional.
    implement -> commit_gate;

    // (3) Gate SUCCESS → review.
    commit_gate -> review [
        condition="outcome.status == 'SUCCESS'"
    ];

    // (4) Gate deterministic failure (build error, test assertion) → fix-loop.
    // Capped at 3: at most 3 fix attempts before escalating.
    commit_gate -> implement [
        condition="outcome.status == 'FAIL' && outcome.failure_class == 'deterministic'",
        traversal_cap="3"
    ];

    // (5) Gate transient failure (infra glitch, timeout) → self-loop retry.
    // Capped at 2: transient retries are limited to avoid masking real failures.
    commit_gate -> commit_gate [
        condition="outcome.status == 'FAIL' && outcome.failure_class == 'transient'",
        traversal_cap="2"
    ];

    // (6) Gate fallback (canceled / structural / unknown) → triage.
    // Unconditional fallback — REQUIRED by D-edge-cascade-invariant (WG-011).
    // Must appear last among commit_gate outgoing edges.
    commit_gate -> "close-needs-attention";

    // (7) APPROVE → close. THIS IS THE SOLE INBOUND EDGE TO close.
    review -> close [
        condition="outcome.preferred_label == 'APPROVE'"
    ];

    // (8) REQUEST_CHANGES → loop back to implement (capped at 3 per EM-015e/WG-028).
    review -> implement [
        condition="outcome.preferred_label == 'REQUEST_CHANGES'",
        traversal_cap="3"
    ];

    // (9) BLOCK → close-needs-attention.
    review -> "close-needs-attention" [
        condition="outcome.preferred_label == 'BLOCK'"
    ];

    // (10) Unconditional fallback — REQUIRED by D-edge-cascade-invariant (WG-011).
    // Catches any unrecognized or absent preferred_label. Must appear last.
    review -> "close-needs-attention";
}
