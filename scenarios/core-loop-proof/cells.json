{
  "//": "to the claude cells. gap1 is asserted everywhere (it is the T2-implemented gap).",
  "//mode": "EVERY cell asserts dispatch.workflow_mode=\"dot\", and that is not a",
  "//mode2": "mistake in the single cells. A version-2 run_started record carries \"dot\"",
  "//mode3": "for every run, because the daemon resolves a DOT graph before it emits the",
  "//mode4": "event (execution-model.md §4.3 EM-012a and §4.4; event-model.md §8.1). A",
  "//mode5": "workflow:single bead label is a graph SELECTION request, not an execution",
  "//mode6": "mode: it selects the embedded no-review-bead graph. The single-versus-",
  "//mode7": "reviewed distinction therefore rides on review_policy and workflow_",
  "//mode8": "selection_source, which is why every cell now asserts those two as well.",
  "//workflow_id": "EVERY cell asserts dispatch.workflow_id_present=false. The daemon DOES",
  "//workflow_id2": "emit workflow_id now (core.RunStartedPayload requires a valid descriptor),",
  "//workflow_id3": "so this assertion is weaker than the spec allows, not wrong. Raising it to",
  "//workflow_id4": "true is a tracked follow-up that wants one live run to confirm the value",
  "//workflow_id5": "each cell resolves, not a core-loop gap.",
  "schema_version": 1,
  "cells": [
    {
      "cell": "codex:local",
      "harness": "codex",
      "substrate": "local",
      "seed_bead": "codex",
      "expect": {
        "harness_selected": {
          "agent_type": "codex",
          "tier": 1
        },
        "model_selected": {
          "harness": "codex",
          "model": "@resolved",
          "no_leak_models": ["@foreign"]
        },
        "terminal": "pass",
        "dispatch": {
          "workflow_mode": "dot",
          "workflow_id_present": false,
          "review_policy": "reviewed",
          "workflow_selection_source": "project_default"
        },
        "provider": {
          "enabled": true
        },
        "lands_on": "main"
      },
      "gaps": [
        "gap1",
        "gap3",
        "gap4",
        "t10"
      ]
    },
    {
      "cell": "codex:remote",
      "harness": "codex",
      "substrate": "remote",
      "seed_bead": "codex",
      "expect": {
        "harness_selected": {
          "agent_type": "codex",
          "tier": 1
        },
        "model_selected": {
          "harness": "codex",
          "model": "@resolved",
          "no_leak_models": ["@foreign"]
        },
        "terminal": "pass",
        "dispatch": {
          "workflow_mode": "dot",
          "workflow_id_present": false,
          "review_policy": "reviewed",
          "workflow_selection_source": "project_default"
        },
        "provider": {
          "enabled": true
        },
        "lands_on": "main"
      },
      "gaps": [
        "gap1",
        "gap2",
        "gap3",
        "gap4",
        "t10"
      ]
    },
    {
      "//": "pi single cell: the pi seed carries workflow:single (D3). That label is a",
      "//2": "tier-1 GRAPH SELECTION, not an execution mode — it selects the embedded",
      "//3": "no-review-bead graph over the dot daemon-default, so the run reports",
      "//4": "workflow_mode=dot, review_policy=no_review, and workflow_selection_source=",
      "//5": "legacy_single_label. Lands on the per-bead integration branch (D2), git-",
      "//6": "verified by the runner (not the dead workspace_merge_status event).",
      "cell": "pi:local",
      "harness": "pi",
      "substrate": "local",
      "seed_bead": "pi",
      "expect": {
        "harness_selected": {
          "agent_type": "pi",
          "tier": 1
        },
        "model_selected": {
          "harness": "pi",
          "model": "@resolved",
          "no_leak_models": ["@foreign"]
        },
        "terminal": "pass",
        "dispatch": {
          "workflow_mode": "dot",
          "workflow_id_present": false,
          "review_policy": "no_review",
          "workflow_selection_source": "legacy_single_label"
        },
        "provider": {
          "enabled": true
        },
        "lands_on": "core-loop-proof-integ"
      },
      "gaps": [
        "gap1",
        "gap3",
        "gap4",
        "t10"
      ]
    },
    {
      "//": "pi-dot cell (D4): dot-mode review->implement round-trip, BOTH nodes on the pi family.",
      "//2": "The pi-dot seed carries harness:pi + workflow:dot; the scratch project's",
      "//3": "workflow.dot is provisioned to review-loop.dot (unpinned reviewer => inherits",
      "//4": "the implementer's pi harness+model => same-model). gap6 asserts the ordered",
      "//5": "round-trip (REQUEST_CHANGES -> implementer re-dispatch -> APPROVE -> close) AND",
      "//6": "that every model_selected == the resolved pi model (no claude leak). Run via EXTRA_CELLS.",
      "cell": "pi-dot:local",
      "harness": "pi",
      "substrate": "local",
      "seed_bead": "pi-dot",
      "expect": {
        "harness_selected": {
          "agent_type": "pi",
          "tier": 1
        },
        "model_selected": {
          "harness": "pi",
          "model": "@resolved",
          "no_leak_models": ["@foreign"]
        },
        "terminal": "pass",
        "//dispatch": "gap4 here proves the dot: label reached the resolver: the seed's",
        "//dispatch2": "dot:review-loop label pins review-loop.dot, so the selection source is",
        "//dispatch3": "explicit_ref and the policy is reviewed. Contrast the single cells, which",
        "//dispatch4": "resolve legacy_single_label + no_review from the SAME workflow_mode value.",
        "//dispatch5": "workflow_id_present stays false here for the same reason as every other",
        "//dispatch6": "cell — see the file-level //workflow_id note.",
        "dispatch": {
          "workflow_mode": "dot",
          "workflow_id_present": false,
          "review_policy": "reviewed",
          "workflow_selection_source": "explicit_ref"
        },
        "provider": {
          "enabled": true
        },
        "lands_on": "core-loop-proof-dot-integ"
      },
      "gaps": [
        "gap1",
        "gap3",
        "gap4",
        "gap6",
        "t10"
      ]
    },
    {
      "cell": "pi:remote",
      "harness": "pi",
      "substrate": "remote",
      "seed_bead": "pi",
      "expect": {
        "harness_selected": {
          "agent_type": "pi",
          "tier": 1
        },
        "model_selected": {
          "harness": "pi",
          "model": "@resolved",
          "no_leak_models": ["@foreign"]
        },
        "terminal": "pass",
        "dispatch": {
          "workflow_mode": "dot",
          "workflow_id_present": false,
          "review_policy": "no_review",
          "workflow_selection_source": "legacy_single_label"
        },
        "provider": {
          "enabled": true
        },
        "lands_on": "main"
      },
      "gaps": [
        "gap1",
        "gap2",
        "gap3",
        "gap4",
        "t10"
      ]
    },
    {
      "cell": "claude:local",
      "harness": "claude-code",
      "substrate": "local",
      "seed_bead": "claude",
      "expect": {
        "harness_selected": {
          "agent_type": "claude-code",
          "tier": 1
        },
        "model_selected": {
          "harness": "claude-code",
          "model": "@resolved",
          "no_leak_models": ["@foreign"]
        },
        "terminal": "pass",
        "dispatch": {
          "workflow_mode": "dot",
          "workflow_id_present": false,
          "review_policy": "no_review",
          "workflow_selection_source": "legacy_single_label"
        },
        "provider": {
          "enabled": true
        },
        "agent_ready": {
          "required": true
        },
        "lands_on": "main"
      },
      "gaps": [
        "gap1",
        "gap3",
        "gap4",
        "gap5",
        "t10"
      ]
    },
    {
      "cell": "claude:remote",
      "harness": "claude-code",
      "substrate": "remote",
      "seed_bead": "claude",
      "expect": {
        "harness_selected": {
          "agent_type": "claude-code",
          "tier": 1
        },
        "model_selected": {
          "harness": "claude-code",
          "model": "@resolved",
          "no_leak_models": ["@foreign"]
        },
        "terminal": "pass",
        "dispatch": {
          "workflow_mode": "dot",
          "workflow_id_present": false,
          "review_policy": "no_review",
          "workflow_selection_source": "legacy_single_label"
        },
        "provider": {
          "enabled": true
        },
        "agent_ready": {
          "required": true
        },
        "lands_on": "main"
      },
      "gaps": [
        "gap1",
        "gap2",
        "gap3",
        "gap4",
        "gap5",
        "t10"
      ]
    }
  ]
}
