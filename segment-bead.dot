// segment-bead.dot — the bead workflow for segment / kernel work (v1)
//
// Same topology as specs/examples/standard-bead.dot: implement → commit_gate
// → review → close, with review APPROVE as the SOLE inbound edge to close. It
// differs in ONE node: the commit_gate runs `make segments`, not `make core`.
//
// WHY A SEPARATE GRAPH. A segment or kernel bead touches the new go.work
// modules (contract, kernel, tools/echo), which the core set (CORE_PKGS) does
// not build and `make core` does not test. Gating that work on `make core`
// would ask a question about the queue path — "can this run beads through the
// queue?" — that a kernel change does not answer, and would leave the segment's
// own build, its boundary rules and its full-strength lint ungated. `make
// segments` is the gate built for this work: it builds+vets+tests+lints each
// segment module and runs the three boundary checks (import-closure,
// tool-isolation, kernel-vocabulary). It is scoped to the new modules and never
// runs internal/, so it stays cheap.
//
// Topology:
//   start
//   → implement (agent: implementer; commit required)
//   → commit_gate (tool: make segments — the segment modules + boundary checks; fail-closed)
//     SUCCESS                   → review
//     FAIL + deterministic      → implement (fix-loop, capped at 3)
//     FAIL + transient          → commit_gate (self-loop, capped at 2)
//     fallback                  → close-needs-attention (canceled / structural)
//   → review (agent: reviewer)
//     APPROVE                   → close (SOLE inbound edge to close)
//     REQUEST_CHANGES           → implement (fix-loop, capped at 3)
//     BLOCK                     → close-needs-attention
//     fallback                  → close-needs-attention
//
// The SOLE-inbound-edge invariant (only review→close[APPROVE] reaches close) is
// a contract this graph is written to, UNASSERTED here as in standard-bead.dot.
// Treat it as a rule a human holds, not one the suite catches.
//
// Spec refs:
//   - specs/examples/standard-bead.dot (the topology this graph copies)
//   - specs/workflow-graph.md §4 WG-039 — tool_command / shell handler
//   - specs/workflow-graph.md §5 WG-011 — unconditional-edge fallback invariant
//   - specs/workflow-graph.md §6 WG-013 — v1 edge-condition dialect (== and && only)
//   - specs/workflow-graph.md §6 WG-028 — traversal_cap
//   - specs/workflow-graph.md §8 WG-021..WG-023 — terminal-node declaration
//   - specs/workflow-graph.md §9 WG-027 — start_node attribute
//   - specs/execution-model.md §II.7 EM-057 item 7 — exit-code → outcome
//   - specs/execution-model.md §EM-015d (review-loop topology / verdict routing)
//   - specs/execution-model.md §EM-015e (iteration cap + no-progress detector)
//   - specs/handler-contract.md §III.1 HC-063 — in-process shell handler
//   - specs/handler-contract.md §4.1 HC-001 — handler_ref required on every node
//
// Layout of record: plans/2026-09-07-harmonik-restructure/
//   07-segmented-structure-and-day1-standards.md (§3, the day-one standards)
//   and 06-segmented-layout.md.

digraph "segment-bead" {
    // ─── Graph-level attributes ──────────────────────────────────────────────
    schema_version="1";
    version="1.0";
    workflow_id="segment-bead";
    start_node="start";
    terminal_node_ids="close,close-needs-attention";
    context_keys="bead_id";

    // ─── Nodes ───────────────────────────────────────────────────────────────

    // start: workflow entry point.
    start [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="entry"
    ];

    // implement: agentic implementer. On the first visit, produces the change.
    // On re-entry (after REQUEST_CHANGES or a deterministic commit_gate failure),
    // addresses the reviewer feedback or fixes the build/test/boundary failure.
    implement [
        type="agentic",
        agent_type="implementer",
        handler_ref="claude-implementer",
        idempotency_class="non-idempotent",
        role="implement the bead's change; commit required. On re-entry: address reviewer feedback or fix the segments-gate failure."
    ];

    // commit_gate: `make segments` — the scoped gate for the platform
    // re-grounding, defined in the Makefile. It builds, vets, tests and lints
    // each segment module (contract, kernel, tools/echo) and then runs the
    // three boundary checks: import-closure (no segment reaches internal/),
    // tool-isolation (no tools/* requires a sibling tool or the kernel), and
    // kernel-vocabulary (no domain noun in kernel/ Go source).
    //
    // THE GATE IS `make segments`, NOT `make core` OR `make full`. A segment or
    // kernel bead does not touch the queue path CORE_PKGS covers, and `make
    // core` never builds the new modules. `make segments` is scoped to exactly
    // the new modules, so it stays cheap and answers the question this work
    // raises: does the segment build, pass its own full-strength lint, and hold
    // its boundary rules?
    //
    // Fail-closed at every step. No retry, and no path that reports SUCCESS on a
    // timeout, a compile failure, a lint finding, a boundary breach or an exit
    // code nothing recognises.
    //
    // Exit 0 (SUCCESS) → every check passed → advance to review.
    // Non-zero deterministic → build / vet / test / lint / boundary failure → loop back to implement (capped at 3).
    // Non-zero transient → infra glitch → self-loop retry (capped at 2).
    // Any other outcome → unconditional fallback → close-needs-attention.
    commit_gate [
        type="non-agentic",
        handler_ref="shell",
        idempotency_class="idempotent",
        tool_command="make segments",
        // The node timeout must clear the work the node does, or a real red can
        // never report. `make segments` is far cheaper than `make full` — it
        // builds only the new empty-to-small modules and runs three greps — so
        // this ceiling is generous. A timeout here is a hard FAIL, never an
        // approval.
        timeout="1800",
        role="commit gate: make segments — the segment modules + boundary checks; fail-closed; exit 0 = ready for review"
    ];

    // review: agentic reviewer. Emits an Outcome whose preferred_label
    // (APPROVE / REQUEST_CHANGES / BLOCK) drives the cascade below.
    // harness="claude-code" pins review to Claude — the reviewer node stays on
    // Claude by project decision even when the global default is another
    // harness.
    review [
        type="agentic",
        agent_type="reviewer",
        handler_ref="claude-reviewer",
        idempotency_class="idempotent",
        model="claude-opus-4-8",
        harness="claude-code",
        role="render APPROVE / REQUEST_CHANGES / BLOCK verdict on the change"
    ];

    // close: terminal node — APPROVE path only. The SOLE inbound edge is
    // review→close[APPROVE]. No other path reaches this node.
    close [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="APPROVE — change accepted and ready to merge"
    ];

    // close-needs-attention: terminal node for BLOCK, cap-hit, gate fallback,
    // and any unrecognized outcome.
    "close-needs-attention" [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="BLOCK / cap-hit / structural / unexpected — operator attention required"
    ];

    // ─── Edges ───────────────────────────────────────────────────────────────

    // (1) Entry edge — unconditional.
    start -> implement;

    // (2) Implementer advances to commit_gate — unconditional.
    implement -> commit_gate;

    // (3) Gate SUCCESS → review.
    commit_gate -> review [
        condition="outcome.status == 'SUCCESS'"
    ];

    // (4) Gate deterministic failure (build error, test/lint/boundary failure) → fix-loop.
    // Capped at 3: at most 3 fix attempts before escalating.
    commit_gate -> implement [
        condition="outcome.status == 'FAIL' && outcome.failure_class == 'deterministic'",
        traversal_cap="3"
    ];

    // (5) Gate transient failure (infra glitch, timeout) → self-loop retry.
    // Capped at 2: transient retries are limited to avoid masking real failures.
    commit_gate -> commit_gate [
        condition="outcome.status == 'FAIL' && outcome.failure_class == 'transient'",
        traversal_cap="2"
    ];

    // (6) Gate fallback (canceled / structural / unknown) → triage.
    // Unconditional fallback — REQUIRED by D-edge-cascade-invariant (WG-011).
    // Must appear last among commit_gate outgoing edges.
    commit_gate -> "close-needs-attention";

    // (7) APPROVE → close. THIS IS THE SOLE INBOUND EDGE TO close.
    review -> close [
        condition="outcome.preferred_label == 'APPROVE'"
    ];

    // (8) REQUEST_CHANGES → loop back to implement (capped at 3 per EM-015e/WG-028).
    review -> implement [
        condition="outcome.preferred_label == 'REQUEST_CHANGES'",
        traversal_cap="3"
    ];

    // (9) BLOCK → close-needs-attention.
    review -> "close-needs-attention" [
        condition="outcome.preferred_label == 'BLOCK'"
    ];

    // (10) Unconditional fallback — REQUIRED by D-edge-cascade-invariant (WG-011).
    // Catches any unrecognized or absent preferred_label. Must appear last.
    review -> "close-needs-attention";
}
