// standard-bead.dot — the standard harmonik bead workflow (v1)
//
// The canonical bead lifecycle: implement → commit-gate (build+vet+test+scenario)
// → independent review → close, with review APPROVE as the SOLE inbound edge to
// close. Unions implement-review-fix.dot and green-build-merge-gate.dot into one
// complete workflow. No daemon code change required.
//
// Topology:
//   start
//   → implement (agent: implementer; commit required)
//   → commit_gate (tool: make full — the whole-repo merge decision, fail-closed)
//     SUCCESS                   → review
//     FAIL + deterministic      → implement (fix-loop, capped at 3)
//     FAIL + transient          → commit_gate (self-loop, capped at 2)
//     fallback                  → close-needs-attention (canceled / structural)
//   → review (agent: reviewer — reads the diff)
//     APPROVE                   → qa
//     REQUEST_CHANGES           → implement (fix-loop, capped at 3)
//     BLOCK                     → close-needs-attention
//     fallback                  → close-needs-attention
//   → qa (agent: reviewer-class QA — EXECUTES the code + edge-case testing)
//     APPROVE                   → close (SOLE inbound edge to close)
//     REQUEST_CHANGES           → implement (fix-loop, capped at 3)
//     BLOCK                     → close-needs-attention
//     fallback                  → close-needs-attention
//
// Key design decisions:
//   D1=A: single shell commit_gate node (NOT separate build/test/scenario nodes).
//   D3=v2: the gate is `make full` — WHOLE REPO, fail-closed. This reverses
//     the affected-package-scoped, fail-open v1.1 gate and deletes the script
//     that implemented it. Two reasons. Scoping asked git what changed since
//     main to choose packages: main is hundreds of commits behind, and even
//     from a fresh base the question cannot find a break in a package the
//     change did not touch, which is the usual case because internal/daemon
//     imports eight other packages. Measured 2026-08-03, the whole repo costs
//     about 13 seconds more than internal/daemon alone, so the scoping bought
//     nothing. And the script had five ways to APPROVE work that never passed
//     (compile failure, timeout, signal kill, unrecognized exit code, and a
//     retry that allowed when the second run passed) against one way to block.
//     The v1.1 rationale was that a pre-existing RED in an unrelated package
//     would block every bead. That is true and it is the correct outcome: a
//     tree with a red test is a tree nothing should merge into. Fix the red.
//   The SOLE-inbound-edge invariant: no path reaches close except review→close[APPROVE].
//     This is a golden-test-asserted contract (see internal/workflow/scenario_standard_bead_hkp0kum_test.go).
//
// Spec refs:
//   - docs/sdlc-workflow-corpus.md §1  (implement-review-fix reference topology)
//   - docs/sdlc-workflow-corpus.md §15 (green-build-merge-gate topology)
//   - specs/workflow-graph.md §4 WG-039 — tool_command / shell handler
//   - specs/workflow-graph.md §5 WG-011 — unconditional-edge fallback invariant
//   - specs/workflow-graph.md §6 WG-013 — v1 edge-condition dialect (== and && only)
//   - specs/workflow-graph.md §6 WG-028 — traversal_cap
//   - specs/workflow-graph.md §8 WG-021..WG-023 — terminal-node declaration
//   - specs/workflow-graph.md §9 WG-027 — start_node attribute
//   - specs/execution-model.md §II.7 EM-057 item 7 — exit-code → outcome
//   - specs/execution-model.md §EM-015d (review-loop topology / verdict routing)
//   - specs/execution-model.md §EM-015e (iteration cap + no-progress detector)
//   - specs/handler-contract.md §III.1 HC-063 — in-process shell handler
//   - specs/handler-contract.md §4.1 HC-001 — handler_ref required on every node
//
// Source: harmonik-productization-design workflow 2026-06-02.
// Bead ref: hk-p0kum.

digraph "standard-bead" {
    // ─── Graph-level attributes ──────────────────────────────────────────────
    schema_version="1";
    version="1.0";
    workflow_id="standard-bead";
    start_node="start";
    terminal_node_ids="close,close-needs-attention";
    context_keys="bead_id";

    // ─── Nodes ───────────────────────────────────────────────────────────────

    // start: workflow entry point.
    start [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="entry"
    ];

    // implement: agentic implementer. On the first visit, produces the change.
    // On re-entry (after REQUEST_CHANGES or a deterministic commit_gate failure),
    // addresses the reviewer feedback or fixes the build/test failure.
    implement [
        type="agentic",
        agent_type="implementer",
        handler_ref="claude-implementer",
        idempotency_class="non-idempotent",
        role="implement the bead's change; commit required. On re-entry: address reviewer feedback or fix the build/test failure."
    ];

    // commit_gate: `make full` — the merge decision, defined in the Makefile.
    // It runs the format check, `go build ./...`, `go vet ./...`, the tagged
    // vet, the subsystem freeze greps, the changed-line lint, a compile of
    // every _test.go file, `go test -short -count=1 ./...` over EVERY package,
    // the whole-tree lint ceiling, the tagged scenario tier, the crash tier and
    // the module hygiene checks.
    //
    // Fail-closed at every step. No package scoping, no retry, and no path that
    // reports SUCCESS on a timeout, an OOM, a compile failure or an exit code
    // nothing recognised. scripts/gate-fails-closed-test.sh holds that.
    //
    // Keeping the gate here rather than in the graph is deliberate: the graph
    // used to carry its own copy of the command, so the graph and the Makefile
    // could disagree about what "passing" meant. There is one definition now.
    // Exit 0 (SUCCESS) → every check passed → advance to review.
    // Non-zero deterministic → build / vet / test-compile / test failure → loop back to implement (capped at 3).
    // Non-zero transient → infra glitch → self-loop retry (capped at 2).
    // Any other outcome → unconditional fallback → close-needs-attention.
    commit_gate [
        type="non-agentic",
        handler_ref="shell",
        idempotency_class="idempotent",
        tool_command="make full",
        // The node timeout must clear the work the node does, or a real red can
        // never report. That is the history here: at 900s this node timed out
        // deterministically, was classified TRANSIENT, burned its self-loop
        // budget and died in close-needs-attention having never said WHICH test
        // failed. 1800s was then sized for a gate that tested only the affected
        // packages and retried them once.
        //
        // `make full` does more and retries nothing. Measured on this box,
        // 2026-08-03, warm cache: static half about 90s, compile every test file
        // about 60s, whole-repo `go test -short` 340s, the tagged scenario tier
        // up to its own 10m budget, module hygiene about 60s. That is roughly
        // 22 minutes at the worst case. 3600s doubles it, which covers a cold
        // cache and a loaded box (load average 43.67 has been observed during
        // this node). A timeout here is a hard FAIL, never an approval.
        timeout="3600",
        role="commit gate: make full — whole-repo build, vet, tests, lint ceiling and scenario tier, fail-closed; exit 0 = ready for review"
    ];

    // review: agentic reviewer. Emits an Outcome whose preferred_label
    // (APPROVE / REQUEST_CHANGES / BLOCK) drives the cascade below.
    // harness="claude-code" pins review to Claude at tier 3 so the reviewer
    // stays on Claude even when the global default (tier 4) is pi — avoids
    // the Pi-reviewer pane seed-paste bug (hk-z4nif). hk-ytzj2.
    review [
        type="agentic",
        agent_type="reviewer",
        handler_ref="claude-reviewer",
        idempotency_class="idempotent",
        model="claude-opus-4-8",
        harness="claude-code",
        role="render APPROVE / REQUEST_CHANGES / BLOCK verdict on the change"
    ];

    // qa: agentic QA gate — runs AFTER review APPROVE. Reviewer-class node
    // (agent_type="reviewer" + handler_ref="claude-reviewer") so it reuses the
    // verdict machinery: writes .harmonik/review.json with APPROVE / REQUEST_CHANGES
    // / BLOCK, and that preferred_label drives the cascade. Unlike `review` (which
    // reads the diff), QA MUST actually EXECUTE the changed code, run it, and
    // exercise edge cases before it can APPROVE. harness="claude-code" gives it a
    // real execution environment in the worktree; model pinned to opus like review.
    qa [
        type="agentic",
        agent_type="reviewer",
        handler_ref="claude-reviewer",
        idempotency_class="idempotent",
        model="claude-opus-4-8",
        harness="claude-code",
        role="QA gate — you are the last line of defense before merge. Do NOT merely read the diff. ACTUALLY EXECUTE the changed code: build it (go build ./... and any affected binaries), run the specific commands/flows the bead changed, and exercise EDGE CASES (empty input, boundary values, error paths, concurrent/repeat invocation, malformed input). Reproduce the bead's stated goal end-to-end and confirm the observed behavior matches what was asked — not just that tests pass. Write your verdict to .harmonik/review.json: APPROVE only if you ran the code and it demonstrably works including edge cases; REQUEST_CHANGES (with concrete repro steps + the failing case in notes) if execution reveals ANY defect or the change does not actually do what the bead required; BLOCK only if the change cannot be validated at all. When in doubt, REQUEST_CHANGES — never APPROVE code you did not execute."
    ];

    // close: terminal node — APPROVE path only. The SOLE inbound edge is
    // qa->close[APPROVE] (QA runs after review; review->qa->close). No other path
    // reaches this node.
    close [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="APPROVE — change accepted and ready to merge"
    ];

    // close-needs-attention: terminal node for BLOCK, cap-hit, gate fallback,
    // and any unrecognized outcome.
    "close-needs-attention" [
        type="non-agentic",
        handler_ref="noop",
        idempotency_class="idempotent",
        role="BLOCK / cap-hit / structural / unexpected — operator attention required"
    ];

    // ─── Edges ───────────────────────────────────────────────────────────────

    // (1) Entry edge — unconditional.
    start -> implement;

    // (2) Implementer advances to commit_gate — unconditional.
    implement -> commit_gate;

    // (3) Gate SUCCESS → review.
    commit_gate -> review [
        condition="outcome.status == 'SUCCESS'"
    ];

    // (4) Gate deterministic failure (build error, test assertion) → fix-loop.
    // Capped at 3: at most 3 fix attempts before escalating.
    commit_gate -> implement [
        condition="outcome.status == 'FAIL' && outcome.failure_class == 'deterministic'",
        traversal_cap="3"
    ];

    // (5) Gate transient failure (infra glitch, timeout) → self-loop retry.
    // Capped at 2: transient retries are limited to avoid masking real failures.
    commit_gate -> commit_gate [
        condition="outcome.status == 'FAIL' && outcome.failure_class == 'transient'",
        traversal_cap="2"
    ];

    // (6) Gate fallback (canceled / structural / unknown) → triage.
    // Unconditional fallback — REQUIRED by D-edge-cascade-invariant (WG-011).
    // Must appear last among commit_gate outgoing edges.
    commit_gate -> "close-needs-attention";

    // (7) Review APPROVE → QA gate (NOT close). QA must execute the code before merge.
    review -> qa [
        condition="outcome.preferred_label == 'APPROVE'"
    ];

    // (8) REQUEST_CHANGES → loop back to implement (capped at 3 per EM-015e/WG-028).
    review -> implement [
        condition="outcome.preferred_label == 'REQUEST_CHANGES'",
        traversal_cap="3"
    ];

    // (9) BLOCK → close-needs-attention.
    review -> "close-needs-attention" [
        condition="outcome.preferred_label == 'BLOCK'"
    ];

    // (10) Unconditional fallback — REQUIRED by D-edge-cascade-invariant (WG-011).
    // Catches any unrecognized or absent preferred_label. Must appear last.
    review -> "close-needs-attention";

    // (11) QA APPROVE → close. THIS IS THE SOLE INBOUND EDGE TO close.
    // QA executed the changed code and confirmed it works incl. edge cases.
    qa -> close [
        condition="outcome.preferred_label == 'APPROVE'"
    ];

    // (12) QA REQUEST_CHANGES → back to implement (fix-loop, capped at 3).
    qa -> implement [
        condition="outcome.preferred_label == 'REQUEST_CHANGES'",
        traversal_cap="3"
    ];

    // (13) QA BLOCK → close-needs-attention (cannot validate / structural).
    qa -> "close-needs-attention" [
        condition="outcome.preferred_label == 'BLOCK'"
    ];

    // (14) Unconditional fallback — REQUIRED by D-edge-cascade-invariant (WG-011).
    // Must appear last among qa outgoing edges.
    qa -> "close-needs-attention";
}
